# ==============================================================================
# Me'morAI — Environment Configuration Template (.env.example)
# Nusxa oling: cp .env.example .env va haqiqiy kalitlarni kiriting.
# DIQQAT: .env faylini hech qachon Git repozitoriyasiga commit qilmang!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Asosiy Ilova Sozlamalari (Application Settings)
# ------------------------------------------------------------------------------
APP_NAME=MemoreAI
ENVIRONMENT=production
DEBUG=false
# 32+ belgili tasodifiy kalit: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_32_char_secret_key
API_PORT=8000
REDIS_PORT=6379
TIMEZONE=Asia/Tashkent

# ------------------------------------------------------------------------------
# 2. Ma'lumotlar Bazasi (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL ulanish satri (Session pooler yoki Direct connection)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase API sozlamalari
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 3. Redis & Celery (Asinxron Vazifalar Navbati)
# ------------------------------------------------------------------------------
# Lokal Docker Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:replace_with_strong_redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace_with_strong_redis_password@redis:6379/1

# Muqobil: Upstash Serverless Redis (Serverless / Cloud muhiti uchun)
UPSTASH_REDIS_REST_URL=https://YOUR_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ------------------------------------------------------------------------------
# 4. Sun'iy Intellekt va Kompyuter Ko'rishi (Multimodal AI & Vision APIs)
# ------------------------------------------------------------------------------
# Chizma va loyihalarni tahlil qilish uchun Google Gemini API kaliti
GEMINI_API_KEY=your_google_gemini_api_key_here

# Muqobil AI provayderlari (ixtiyoriy)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 5. Telegram Bot va WebApp Integratsiyasi
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_IDS=12345678,87654321
TELEGRAM_WEBAPP_URL=https://memore.uz/webapp

# ------------------------------------------------------------------------------
# 6. Fayllar Saqlash va Cheklovlar (Uploads & Storage)
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,dwg,dxf,png,jpg,jpeg

# ------------------------------------------------------------------------------
# 7. CORS va Xavfsizlik (Security & Allowed Origins)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://memore.uz
